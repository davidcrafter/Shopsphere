# Browser-safe public configuration
VITE_SITE_URL=http://localhost:5173
VITE_CONTACT_EMAIL=ibyizamart@gmail.com
VITE_CONTACT_PHONE=
VITE_BUSINESS_LOCATION=Kigali, Rwanda
VITE_DEFAULT_CURRENCY=RWF # fixed operating currency; changing it is unsupported without a reviewed multi-currency implementation
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Demo records are local-development only. They are never shown when Supabase is configured.
VITE_ENABLE_DEMO_DATA=true
# Test checkout must remain false in production.
VITE_ENABLE_TEST_CHECKOUT=false
VITE_ANALYTICS_PROVIDER=none
VITE_PLAUSIBLE_DOMAIN=

# Supabase Edge Function secrets (set with `supabase secrets set`; NEVER prefix with VITE_)
# ALLOWED_ORIGIN=https://your-domain.example
# ALLOW_TEST_CHECKOUT=true                 # use only in an isolated non-production project
# SUPABASE_SERVICE_ROLE_KEY=managed-by-supabase
# Add a verified live payment-provider secret only after business approval and official integration testing.
